# Backend runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEATHER_PROVIDER=open_meteo
WEATHER_HTTP_TIMEOUT_SECONDS=10
WEATHER_MAX_STALENESS_MINUTES=90
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_MAX_RETRIES=2
MODEL_ARTIFACT_PATH=models/weather_risk_model.joblib
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=WeatherRiskAI/0.1 (student decision-support project)
# Reverse lookups use the weather timeout/retry/cache settings above.

# Optional LLM explanation adapter. Leave unset: deterministic template explanation is used.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
